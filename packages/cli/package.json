{
  "name": "@typed-code/cli",
  "version": "0.1.0",
  "description": "pi-tui interactive CLI for typed-code",
  "type": "module",
  "bin": {
    "typed-code-cli": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.1",
    "@typed-code/sdk": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=22"
  }
}
