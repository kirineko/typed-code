        "transcript": {
          "items": {
            "discriminator": {
              "mapping": {
                "assistant_message": "#/$defs/AssistantMessageItem",
                "system_notice": "#/$defs/SystemNoticeItem",
                "thinking": "#/$defs/ThinkingItem",
                "tool_call": "#/$defs/ToolCallItem",
                "tool_result": "#/$defs/ToolResultItem",
                "user_message": "#/$defs/UserMessageItem"
