          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "latest_event_sequence": {
          "default": 0,
          "minimum": 0,
          "title": "Latest Event Sequence",
          "type": "integer"
        }
