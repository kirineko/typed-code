            "oneOf": [
              {
                "$ref": "#/$defs/UserMessageItem"
              },
              {
                "$ref": "#/$defs/AssistantMessageItem"
              },
              {
                "$ref": "#/$defs/ThinkingItem"
              },
              {
                "$ref": "#/$defs/ToolCallItem"
              },
              {
                "$ref": "#/$defs/ToolResultItem"
              },
              {
                "$ref": "#/$defs/SystemNoticeItem"
              }
            ]
          },
          "title": "Transcript",
          "type": "array"
        },
