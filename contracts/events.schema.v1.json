        "type": {
          "const": "message.user",
          "default": "message.user",
          "title": "Type",
          "type": "string"
        },
        "item": {
          "discriminator": {
            "mapping": {
              "assistant_message": "#/$defs/AssistantMessageItem",
              "system_notice": "#/$defs/SystemNoticeItem",
              "thinking": "#/$defs/ThinkingItem",
              "tool_call": "#/$defs/ToolCallItem",
              "tool_result": "#/$defs/ToolResultItem",
              "user_message": "#/$defs/UserMessageItem"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UserMessageItem"
            },
            {
              "$ref": "#/$defs/AssistantMessageItem"
            },
            {
              "$ref": "#/$defs/ThinkingItem"
            },
            {
              "$ref": "#/$defs/ToolCallItem"
            },
            {
              "$ref": "#/$defs/ToolResultItem"
            },
